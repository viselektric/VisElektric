<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kalkulator instalacji – VisElektric</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#eef1f4; --panel:#ffffff; --ink:#14202b; --muted:#566574; --line:#cfd7de;
  --blue:#1f5fbf; --yellow:#f2c300; --green:#2e8b57;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#10171e;--panel:#18212a;--ink:#e8edf1;--muted:#9aa9b6;--line:#2b3946;--blue:#6aa3ff;color-scheme:dark}
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Archivo",system-ui,sans-serif;line-height:1.55;font-size:17px}
a{color:var(--blue)}
:focus-visible{outline:3px solid var(--yellow);outline-offset:2px}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
header{position:sticky;top:0;background:var(--bg);border-bottom:1px solid var(--line);z-index:5}
header .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:12px;padding-bottom:12px;flex-wrap:wrap}
.logo{font-weight:800;font-stretch:110%;font-size:1.25rem;text-decoration:none;color:var(--ink);letter-spacing:-.01em}
.logo span{color:var(--blue)}
nav{display:flex;gap:16px;flex-wrap:wrap;font-size:.95rem;font-weight:600}
nav a{color:var(--ink);text-decoration:none}
nav a:hover{text-decoration:underline;text-decoration-color:var(--yellow);text-decoration-thickness:3px;text-underline-offset:5px}
.wires{height:8px;background:linear-gradient(90deg,#7a4a2a 0 33.3%,var(--blue) 33.3% 66.6%,var(--yellow) 66.6% 83%,var(--green) 83%)}
section{padding:56px 0;border-bottom:1px solid var(--line)}
h1,h2,h3{line-height:1.1;margin:0 0 .5em;letter-spacing:-.02em}
h1{font-size:clamp(2.2rem,6vw,3.8rem);font-weight:800;font-stretch:112%;max-width:15ch}
h2{font-size:clamp(1.6rem,4vw,2.2rem);font-weight:750;font-stretch:105%}
h3{font-size:1.1rem;font-weight:700}
p{margin:0 0 1em;max-width:62ch}
.lead{font-size:1.2rem;color:var(--muted)}
.btn{display:inline-block;background:var(--ink);color:var(--bg);padding:13px 22px;border-radius:6px;font-weight:700;text-decoration:none;border:0;font:inherit;font-weight:700;cursor:pointer}
.btn.alt{background:var(--yellow);color:#14202b}
.btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
.box{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:18px}
.box .ph{height:120px;border-radius:5px;background:repeating-linear-gradient(45deg,var(--line) 0 8px,transparent 8px 16px);margin-bottom:12px}
table{width:100%;border-collapse:collapse;background:var(--panel);border:1px solid var(--line);border-radius:8px;overflow:hidden}
td,th{padding:11px 14px;text-align:left;border-bottom:1px solid var(--line)}
td:last-child,th:last-child{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
.tw{overflow-x:auto}
.calc{display:grid;gap:24px;grid-template-columns:1fr}
@media(min-width:860px){.calc{grid-template-columns:1fr 1.1fr}}
.fields{display:grid;gap:14px}
.f{display:flex;justify-content:space-between;align-items:center;gap:12px;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px 14px}
.f label{font-weight:600}
.f small{display:block;font-weight:400;color:var(--muted);font-size:.82rem}
.stepper{display:flex;align-items:center;gap:6px}
.stepper button{width:38px;height:38px;border-radius:6px;border:1px solid var(--line);background:var(--bg);color:var(--ink);font-size:1.2rem;cursor:pointer}
.stepper input{width:54px;height:38px;text-align:center;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);font:inherit}
.chk{justify-content:flex-start}
.chk input{width:22px;height:22px;accent-color:var(--blue)}
.result{background:var(--panel);border:2px solid var(--ink);border-radius:8px;padding:20px;position:sticky;top:76px;align-self:start}
.total{font-size:2.2rem;font-weight:800;font-stretch:110%;font-variant-numeric:tabular-nums}
.grp{font-weight:750;margin:10px 0 -4px}
.dev{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:12px 14px;display:grid;gap:10px}
.dev .row{display:flex;gap:10px;flex-wrap:wrap;align-items:end}
.dev label.s{font-size:.8rem;color:var(--muted);display:grid;gap:3px}
.dev input[type=number],.dev select,.dev input[type=text]{height:38px;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);font:inherit;padding:0 8px;width:84px}
.dev input[type=text]{width:100%}
.dev .res{font-size:.85rem;color:var(--muted)}
.link{background:none;border:0;color:var(--blue);font:inherit;font-weight:600;cursor:pointer;padding:6px 0;text-align:left}
select.big{height:40px;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);font:inherit;padding:0 8px}
.note{font-size:.88rem;color:var(--muted)}
.tag{display:inline-block;background:var(--yellow);color:#14202b;font-weight:700;font-size:.8rem;padding:2px 8px;border-radius:4px}
footer{padding:32px 0;color:var(--muted);font-size:.9rem}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
.opt{background:var(--panel);border:2px solid var(--line);border-radius:10px;padding:22px 16px;font:inherit;font-weight:700;font-size:1.1rem;color:var(--ink);cursor:pointer;text-align:center}
.opt:hover,.opt.on{border-color:var(--blue)}
.opt .ic{display:block;font-size:2rem;margin-bottom:6px}
.fields{display:grid;gap:12px;margin:14px 0}
.prog{display:flex;gap:8px;margin-bottom:8px}
.prog span{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;border:2px solid var(--line);font-weight:700;font-size:.85rem;color:var(--muted)}
.prog .now{background:var(--yellow);border-color:var(--yellow);color:#14202b}
.prog .done{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.btn.ghost{background:transparent;color:var(--ink);border:2px solid var(--line)}
.btn:disabled{opacity:.4;cursor:not-allowed}
.result{position:static}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <a class="logo" href="index.html">Vis<span>Elektric</span></a>
    <nav aria-label="Menu">
      <a href="index.html#o-firmie">O firmie</a><a href="index.html#realizacje">Realizacje</a><a href="index.html#cennik">Cennik</a><a href="kalkulator.html" aria-current="page">Kalkulator</a><a href="index.html#termin">Terminy</a><a href="index.html#kontakt">Kontakt</a>
    </nav>
  </div>
  <div class="wires" aria-hidden="true"></div>
</header>

<main>
<section id="kalkulator" style="border-bottom:0">
  <div class="wrap">
    <h2>Kalkulator instalacji</h2>
    <div id="app"></div>
  </div>
</section>
</main>
<footer><div class="wrap">© <span id="yr"></span> VisElektric</div></footer>
<script>
/* ============ CONFIG – tu zmieniasz ceny ============ */
const CONFIG = {
  punkty: { gniazdko:40, wlacznik:40, tv:45, ethernet:45 },
  rozlacznik: {"4P 40A":60,"4P 63A":70,"4P 80A":80,"4P 100A":90},
  mcb: {B6:25,B10:30,B16:35,B20:40,C10:40,C16:45,C20:50,
        /* przykładowe – nie było w cenniku */ B25:45,B32:55,B40:70,B50:85,B63:100,C25:55,C32:65,C40:80,C50:95,C63:110},
  mcbPrzykladowe: /^[BC](25|32|40|50|63)$/,
  rcd: 140,        // różnicówka 30 mA – przykładowa
  spd: 180,        // ochronnik przepięć – przykładowa
  listwa: {N:40, PE:40},
  swiatlo: {reflektor:50, zyrandolPoj:50, zyrandolPod:60, zyrandolPot:70},
  kamera: {zwykla:80, k360:100, obrotowa:120},
  skrzynka: [0,150,200,250],   // indeks = liczba szyn
  konfiguracja: 200,
  ladowarka: 400,
  modulowNaSzyne: 12,
  gniazdekNaObwod: 8, swiatelNaObwod: 10, obwodowNaRcd: 4,
  maxSpadek: 3
};

/* ============ Dobór przewodu i wyłącznika ============ */
const MCB_STD=[6,10,16,20,25,32,40,50,63];
const SECT=[1.5,2.5,4,6,10,16];
const minSect=In=>In<=10?1.5:In<=16?2.5:In<=25?4:In<=32?6:In<=50?10:16;
function pick(I,L,ph,ch){
  const In=MCB_STD.find(x=>x>=I);
  if(!In) return {err:"prąd powyżej 63 A – dobierz ręcznie"};
  let S=minSect(In);
  const U=ph===3?400:230;
  const drop=S=>(ph===3?Math.sqrt(3):2)*L*I/(56*S)/U*100;
  let d=drop(S);
  while(d>CONFIG.maxSpadek&&S<16){S=SECT[SECT.indexOf(S)+1];d=drop(S)}
  const key=(ch||"B")+In;
  const base=CONFIG.mcb[key]??CONFIG.mcb["B"+In]*1.15;
  return {In,S,cab:(ph===3?5:3)+"×"+S+" mm²",drop:d,key,price:base*(ph===3?3:1),est:CONFIG.mcbPrzykladowe.test(key)||CONFIG.mcb[key]===undefined,
          warn:d>CONFIG.maxSpadek?"spadek napięcia powyżej "+CONFIG.maxSpadek+"%":""};
}

/* ============ Dane kreatora ============ */
const PLACES=[["Dom","🏠"],["Mieszkanie","🏢"],["Garaż","🚗"]];
const KINDS=["Nowa instalacja","Wymiana instalacji"];
const ROOMS={
  "Salon":{gn:6,wl:2,tv:1,eth:1,rf:4,zp:1},
  "Pokój / sypialnia":{gn:5,wl:1,tv:1,eth:1,rf:0,zp:1},
  "Kuchnia":{gn:8,wl:1,rf:4,dev:{"Zmywarka":1,"Piekarnik":1,"Płyta indukcyjna":1}},
  "Łazienka":{gn:2,wl:1,rf:3,dev:{"Pralka":1}},
  "Korytarz":{gn:2,wl:2,rf:3},
  "Piwnica":{gn:3,wl:1,rf:1},
  "Pomieszczenie gospodarcze":{gn:3,wl:1,rf:1},
  "Garaż":{gn:4,wl:1,rf:3},
  "Warsztat":{gn:8,wl:1,rf:4}
};
const ROOMS_BY={Dom:["Salon","Pokój / sypialnia","Kuchnia","Łazienka","Korytarz","Piwnica","Pomieszczenie gospodarcze","Garaż"],
  Mieszkanie:["Salon","Pokój / sypialnia","Kuchnia","Łazienka","Korytarz","Pomieszczenie gospodarcze"],
  "Garaż":["Garaż","Warsztat","Pomieszczenie gospodarcze"]};
const ITEMS=[
 ["Punkty",null],["gn","Gniazdka"],["wl","Włączniki światła"],["tv","Gniazdka TV"],["eth","Gniazdka Ethernet"],
 ["Oświetlenie",null],["rf","Reflektory"],["zp","Żyrandole pojedyncze"],["zd","Żyrandole podwójne"],["zt","Żyrandole potrójne"],
 ["Monitoring",null],["k1","Kamery"],["k2","Kamery 360"],["k3","Kamery obrotowe"]
];
const S={gn:0,wl:0,tv:0,eth:0,rf:0,zp:0,zd:0,zt:0,k1:0,k2:0,k3:0,lad:0};
const DEVS=[];
const addDevData=(name,cnt,A,L,ph,ch,custom)=>DEVS.push({name,cnt,A,L,ph,ch,custom});
addDevData("Zmywarka",0,10,8,1,"B");addDevData("Pralka",0,10,8,1,"B");addDevData("Piekarnik",0,16,8,1,"B");
addDevData("Płyta indukcyjna",0,16,10,3,"B");addDevData("Bojler / podgrzewacz",0,13,10,1,"B");
addDevData("Klimatyzator",0,10,15,1,"C");addDevData("Suszarka do ubrań",0,10,8,1,"B");
addDevData("Pompa ciepła",0,16,15,3,"C");

const W={step:0,place:null,kind:null,rooms:{},roomsKey:""};
const STEPS=["Gdzie","Rodzaj","Pomieszczenia","Wyposażenie","Urządzenia","Wynik"];

function prefill(){
  Object.keys(S).forEach(k=>S[k]=0);
  DEVS.forEach(d=>{if(!d.custom)d.cnt=0});
  for(const [r,n] of Object.entries(W.rooms)){
    const d=ROOMS[r];if(!n||!d)continue;
    ["gn","wl","tv","eth","rf","zp"].forEach(k=>{S[k]+=(d[k]||0)*n});
    if(d.dev)for(const [dn,c] of Object.entries(d.dev)){const x=DEVS.find(q=>q.name===dn);if(x)x.cnt+=c*(dn==="Pralka"?Math.min(n,1):1)}
  }
}

/* ============ Elementy UI ============ */
const app=document.getElementById("app");
const h=(t,c,html)=>{const e=document.createElement(t);if(c)e.className=c;if(html!=null)e.innerHTML=html;return e};
function stepper(parent,label,hint,get,set,max){
  max=max||99;
  const d=h("div","f",`<label>${label}${hint?`<small>${hint}</small>`:""}</label>
    <div class="stepper"><button type="button" aria-label="Mniej">−</button><input type="number" min="0" max="${max}" inputmode="numeric"><button type="button" aria-label="Więcej">+</button></div>`);
  const inp=d.querySelector("input"),[m,p]=d.querySelectorAll("button");
  inp.value=get();
  const upd=v=>{v=Math.max(0,Math.min(max,parseInt(v)||0));set(v);inp.value=v;after&&after()};
  let after=null;
  m.onclick=()=>upd(+inp.value-1);p.onclick=()=>upd(+inp.value+1);inp.oninput=()=>upd(inp.value);
  parent.appendChild(d);return d;
}
function nav(next,disabled){
  const n=h("div","btns");
  if(W.step>0){const b=h("button","btn ghost","← Wstecz");b.type="button";b.onclick=()=>go(W.step-1);n.appendChild(b)}
  if(next){const b=h("button","btn alt",next);b.type="button";b.disabled=!!disabled;b.onclick=()=>go(W.step+1);n.appendChild(b)}
  return n;
}
function go(i){W.step=i;render();window.scrollTo({top:document.getElementById("kalkulator").offsetTop-70,behavior:"smooth"})}
function progress(){
  return `<div class="prog" aria-label="Krok ${W.step+1} z ${STEPS.length}">${STEPS.map((s,i)=>`<span class="${i<W.step?"done":i===W.step?"now":""}">${i+1}</span>`).join("")}</div><div class="note">Krok ${W.step+1} z ${STEPS.length}: ${STEPS[W.step]}</div>`;
}

/* ============ Kroki ============ */
function render(){
  app.innerHTML=progress();
  [s1,s2,s3,s4,s5,s6][W.step]();
}
function s1(){
  app.appendChild(h("h3",null,"Gdzie chcesz mieć instalację?"));
  const g=h("div","grid");
  PLACES.forEach(([p,ic])=>{const b=h("button","opt"+(W.place===p?" on":""),`<span class="ic">${ic}</span>${p}`);b.type="button";
    b.onclick=()=>{if(W.place!==p){W.place=p;W.rooms={};if(p==="Garaż")W.rooms["Garaż"]=1;W.roomsKey=""}go(1)};g.appendChild(b)});
  app.appendChild(g);
}
function s2(){
  app.appendChild(h("h3",null,"Co chcesz zrobić?"));
  const g=h("div","grid");
  KINDS.forEach(k=>{const b=h("button","opt"+(W.kind===k?" on":""),k);b.type="button";b.onclick=()=>{W.kind=k;go(2)};g.appendChild(b)});
  app.appendChild(g);app.appendChild(nav());
}
function s3(){
  app.appendChild(h("h3",null,"Jakie masz pomieszczenia?"));
  app.appendChild(h("p","note","Ustaw ilość. W następnym kroku zaproponuję wyposażenie, które będziesz mógł zmienić."));
  const box=h("div","fields");
  ROOMS_BY[W.place].forEach(r=>stepper(box,r,"",()=>W.rooms[r]||0,v=>{W.rooms[r]=v;updNext()}));
  app.appendChild(box);
  const nv=nav("Dalej →",false);app.appendChild(nv);
  const updNext=()=>{nv.querySelector(".alt").disabled=!Object.values(W.rooms).some(x=>x>0)};
  updNext();
}
function s4(){
  const key=JSON.stringify(W.rooms);
  if(key!==W.roomsKey){prefill();W.roomsKey=key}
  app.appendChild(h("h3",null,"Wyposażenie"));
  app.appendChild(h("p","note","Wstępnie ustawiłem wartości na podstawie pomieszczeń. Popraw według potrzeb."));
  const box=h("div","fields");
  ITEMS.forEach(it=>{
    if(it[1]===null){box.appendChild(h("div","grp",it[0]));return}
    stepper(box,it[1],"",()=>S[it[0]],v=>{S[it[0]]=v});
  });
  if(W.place==="Garaż"){
    box.appendChild(h("div","grp","Garaż"));
    stepper(box,"Instalacja ładowarki do auta","400 zł za sztukę",()=>S.lad,v=>{S.lad=v},9);
  }
  app.appendChild(box);app.appendChild(nav("Dalej →"));
}
function s5(){
  app.appendChild(h("h3",null,"Urządzenia"));
  app.appendChild(h("p","note","Każde urządzenie ma osobny obwód. Wpisz prąd z tabliczki znamionowej i długość linii od skrzynki, a dobiorę wyłącznik i przewód."));
  const box=h("div","fields");app.appendChild(box);
  DEVS.forEach(d=>{
    const el=h("div","dev",`<div class="row" style="justify-content:space-between;align-items:center">
      ${d.custom?`<label class="s" style="flex:1">Nazwa<input type="text" class="nm"></label>`:`<strong>${d.name}</strong>`}
      <div class="stepper"><button type="button" class="mn" aria-label="Mniej">−</button><input class="ct" type="number" min="0" max="99" inputmode="numeric" style="width:54px"><button type="button" class="pl" aria-label="Więcej">+</button></div></div>
      <div class="row">
        <label class="s">Prąd (A)<input class="a" type="number" min="0" step="0.5" inputmode="decimal"></label>
        <label class="s">Linia (m)<input class="l" type="number" min="1" inputmode="numeric"></label>
        <label class="s">Zasilanie<select class="ph"><option value="1">1-faz.</option><option value="3">3-faz.</option></select></label>
        <label class="s">Wyłącznik<select class="ch"><option>B</option><option>C</option></select></label>
        ${d.custom?`<button type="button" class="link rm">Usuń</button>`:""}
      </div>`);
    const q=c=>el.querySelector(c);
    q(".ct").value=d.cnt;q(".a").value=d.A;q(".l").value=d.L;q(".ph").value=d.ph;q(".ch").value=d.ch;
    if(d.custom)q(".nm").value=d.name;
    const sync=()=>{d.cnt=Math.max(0,Math.min(99,parseInt(q(".ct").value)||0));q(".ct").value=d.cnt;d.A=parseFloat(q(".a").value)||0;d.L=parseFloat(q(".l").value)||0;d.ph=+q(".ph").value;d.ch=q(".ch").value;if(d.custom)d.name=q(".nm").value||"Urządzenie"};
    q(".mn").onclick=()=>{q(".ct").value=Math.max(0,+q(".ct").value-1);sync()};
    q(".pl").onclick=()=>{q(".ct").value=Math.min(99,+q(".ct").value+1);sync()};
    el.querySelectorAll("input,select").forEach(i=>{i.oninput=sync;i.onchange=sync});
    if(d.custom)q(".rm").onclick=()=>{DEVS.splice(DEVS.indexOf(d),1);render()};
    box.appendChild(el);
  });
  const ab=h("button","link","+ Dodaj własne urządzenie");ab.type="button";
  ab.onclick=()=>{addDevData("Urządzenie",1,16,10,1,"B",true);render()};box.appendChild(ab);
  app.appendChild(nav("Pokaż wycenę →"));
}

/* ============ Wycena ============ */
const zl=n=>Math.round(n).toLocaleString("pl-PL")+" zł";
function s6(){
  const C=CONFIG,s=S,items=[],cab=new Set(),warns=[];
  const add=(n,q,unit,est)=>{if(q>0)items.push({n,q,sum:unit*q,est})};
  const kam=s.k1+s.k2+s.k3;
  add("Instalacja ładowarki do auta",s.lad,C.ladowarka);
  // obwody ogólne
  const pts=s.rf+s.zp+s.zd+s.zt;
  const obwGn=Math.ceil(s.gn/C.gniazdekNaObwod), obwSw=Math.ceil(pts/C.swiatelNaObwod);
  let circuits=obwGn+obwSw, modules=obwGn+obwSw, threeP=false;
  add("Wyłączniki B16 (gniazdka)",obwGn,C.mcb.B16);
  add("Wyłączniki B10 (światło)",obwSw,C.mcb.B10);
  // urządzenia
  const devLines=[];
  const handle=(name,cnt,A,L,ph,ch)=>{
    const p=pick(A,L,ph,ch);
    if(p.err){warns.push(name+": "+p.err);return}
    add(`Wyłącznik ${ph===3?"3P ":""}${p.key} – ${name}`,cnt,p.price,p.est);
    cab.add(`${p.cab} (${name})`);
    circuits+=cnt;modules+=cnt*(ph===3?3:1);if(ph===3)threeP=true;
    devLines.push(`${name}: wyłącznik ${ph===3?"3P ":""}${p.key}, ${p.cab}, spadek ${p.drop.toFixed(1)}%`);
    if(p.warn)warns.push(name+": "+p.warn);
  };
  DEVS.forEach(d=>{if(d.cnt>0&&d.A>0)handle(d.name,d.cnt,d.A,d.L,d.ph,d.ch)});
  if(s.lad)handle("Ładowarka auta",s.lad,16,15,3,"B");
  // zabezpieczenia wspólne
  const rcd=Math.max(1,Math.ceil(circuits/C.obwodowNaRcd));
  add("Wyłącznik różnicowoprądowy 30 mA",rcd,C.rcd,true);modules+=rcd*2;
  const big=W.place!=="Garaż";
  if(big){add("Ochronnik przepięć (SPD)",1,C.spd,true);modules+=3}
  const In=circuits<=14?40:circuits<=24?63:circuits<=36?80:100;
  const rk=`4P ${In}A`;add("Rozłącznik główny "+rk,1,C.rozlacznik[rk]);modules+=4;
  let rails=Math.ceil(modules*1.3/C.modulowNaSzyne);
  if(rails>3){warns.push("potrzebna większa rozdzielnica niż 3 szyny – dobiorę po oględzinach");rails=3}
  add(`Skrzynka rozdzielcza – ${rails} ${rails===1?"szyna":rails<5?"szyny":"szyn"}`,1,C.skrzynka[rails]);
  add("Listwa N",1,C.listwa.N);add("Listwa PE",1,C.listwa.PE);
  const plan=items.map(i=>({n:i.n,q:i.q,unit:i.sum/i.q,est:i.est}));
  const rooms=Object.entries(W.rooms).filter(([,n])=>n>0).map(([r,n])=>`${r} × ${n}`).join(", ");
  app.appendChild(h("h3",null,"Twoja wycena"));
  app.appendChild(h("p","note",`${W.place} · ${W.kind} · ${rooms}`));
  const res=h("div","result");
  res.innerHTML=`<div class="note">Orientacyjny koszt zabezpieczeń i rozdzielnicy</div><div class="total" id="tot"></div>
   <h3>Proponowane zabezpieczenia</h3>
   <p class="note">Zmień ilości plusem i minusem albo dodaj własne zabezpieczenie poniżej. Koszt przelicza się od razu.</p>
   <div class="tw"><table><tbody id="plan"></tbody></table></div>
   <div class="row" style="display:flex;gap:8px;margin:12px 0;flex-wrap:wrap"><select class="big" id="cat" style="flex:1;min-width:180px"></select><button type="button" class="btn alt" id="addcat">+ Dodaj</button></div>
   ${devLines.length?`<h3>Dobór dla urządzeń</h3><ul style="padding-left:18px;margin:0 0 12px">${devLines.map(c=>`<li>${c}</li>`).join("")}</ul>`:""}
   <p class="note" id="foot"></p>`;
  app.appendChild(res);
  const CAT=[];
  Object.entries(C.mcb).forEach(([k,p])=>{const e=C.mcbPrzykladowe.test(k);CAT.push({n:`Wyłącznik ${k}`,unit:p,est:e});CAT.push({n:`Wyłącznik 3P ${k}`,unit:p*3,est:e})});
  CAT.push({n:"Wyłącznik różnicowoprądowy 30 mA",unit:C.rcd,est:true},{n:"Ochronnik przepięć (SPD)",unit:C.spd,est:true});
  Object.entries(C.rozlacznik).forEach(([k,p])=>CAT.push({n:"Rozłącznik główny "+k,unit:p,est:false}));
  CAT.push({n:"Listwa N",unit:C.listwa.N},{n:"Listwa PE",unit:C.listwa.PE});
  [1,2,3].forEach(r=>CAT.push({n:`Skrzynka rozdzielcza – ${r} ${r===1?"szyna":"szyny"}`,unit:C.skrzynka[r]}));
  const sel=res.querySelector("#cat");
  sel.innerHTML=CAT.map((c,i)=>`<option value="${i}">${c.n} (${zl(c.unit)})</option>`).join("");
  const tb=res.querySelector("#plan"),tot=res.querySelector("#tot"),foot=res.querySelector("#foot");
  const sums=[];
  const upd=()=>{
    const t=plan.reduce((a,i)=>a+i.q*i.unit,0);
    tot.textContent=zl(t);
    plan.forEach((i,k)=>{if(sums[k])sums[k].textContent=zl(i.q*i.unit)});
    foot.innerHTML=(plan.some(i=>i.est)?"* cena przykładowa, do potwierdzenia.<br>":"")+warns.map(w=>"⚠ "+w).join("<br>")+(warns.length?"<br>":"")+`Liczba obwodów: ${circuits}. Gniazdka, włączniki i przewody wyceniam osobno. To propozycja kalkulatora, ostateczny dobór po oględzinach.`+(W.kind==="Wymiana instalacji"?" Demontaż starej instalacji i bruzdy wyceniam osobno.":"");
  };
  const draw=()=>{
    tb.innerHTML="";sums.length=0;
    plan.forEach((i,k)=>{
      const tr=h("tr",null,`<td>${i.n}${i.est?" *":""}</td><td style="text-align:right"><div class="stepper" style="justify-content:flex-end"><button type="button" aria-label="Mniej">−</button><input type="number" min="0" max="99" inputmode="numeric" style="width:48px"><button type="button" aria-label="Więcej">+</button></div></td><td class="sm"></td>`);
      const inp=tr.querySelector("input"),[m,p]=tr.querySelectorAll("button");
      inp.value=i.q;sums[k]=tr.querySelector(".sm");
      const set=v=>{v=Math.max(0,Math.min(99,parseInt(v)||0));i.q=v;inp.value=v;upd()};
      m.onclick=()=>set(i.q-1);p.onclick=()=>set(i.q+1);inp.oninput=()=>{i.q=Math.max(0,Math.min(99,parseInt(inp.value)||0));upd()};
      tb.appendChild(tr);
    });
    upd();
  };
  res.querySelector("#addcat").onclick=()=>{
    const c=CAT[+sel.value];const ex=plan.find(i=>i.n===c.n);
    if(ex)ex.q=Math.min(99,ex.q+1);else plan.push({n:c.n,q:1,unit:c.unit,est:!!c.est});
    draw();
  };
  draw();
  const n=nav();const a=h("a","btn alt","Umów oględziny");a.href="index.html#kontakt";n.appendChild(a);
  const r=h("button","btn ghost","Zacznij od nowa");r.type="button";r.onclick=()=>{W.place=null;W.kind=null;W.rooms={};W.roomsKey="";go(0)};n.appendChild(r);
  app.appendChild(n);
}
document.getElementById("yr").textContent=new Date().getFullYear();
render();

</script>
</body>
</html>
